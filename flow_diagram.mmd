%% STYLES
%% ============================================================
classDef keyStep fill:#ff9900,stroke:#b36b00,color:#000,font-weight:bold
classDef decision fill:#ddeeff,stroke:#336699,color:#000
classDef default fill:#f5f5f5,stroke:#999,color:#000

class F2_J,F3_F,F3_H,F3_M,F4_C keyStep
class F3_I decision
